{
  "name": "foundry-os",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:client": "npm run --prefix client build",
    "build:all": "npm run build && npm run build:client",
    "client:dev": "npm run --prefix client dev",
    "typecheck": "tsc --noEmit",
    "start": "node --max-old-space-size=4096 dist/index.js",
    "start:dev": "npm run build && node --max-old-space-size=4096 dist/index.js",
    "serve": "npm run build:all && node --max-old-space-size=4096 dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.2.0",
    "bullmq": "^5.41.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.5.0",
    "openai": "^7.23.0",
    "pg": "^8.13.3",
    "pgvector": "^0.3.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
