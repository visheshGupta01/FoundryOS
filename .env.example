# Application environment configuration template
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL database connection with pgvector support
DATABASE_URL=postgresql://foundry:foundry_pass@localhost:5432/foundry_os

# Redis connection for BullMQ job queues
REDIS_URL=redis://localhost:6379

# TrueForge agent harness API settings
TRUEFORGE_API_URL=http://localhost:8080
TRUEFORGE_API_KEY=tf_dev_default_key

# Embedding model settings (Local Ollama nomic-embed-text)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=1536

# LLM provider settings (Local Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
