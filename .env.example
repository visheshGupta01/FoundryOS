# application environment configuration template
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# postgresql database connection with pgvector support
DATABASE_URL=postgresql://foundry:foundry_pass@localhost:5432/foundry_os
# redis connection for bullmq job queues
REDIS_URL=redis://localhost:6379
# trueforge agent harness api settings
TRUEFORGE_API_URL=http://localhost:8080
TRUEFORGE_API_KEY=tf_dev_placeholder_key
# embedding model settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# llm provider toggle: "openai" (recommended) or "ollama" (local fallback)
LLM_PROVIDER=openai
# openai configuration (primary provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_STRATEGY_MODEL=gpt-4o
# ollama configuration (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
